{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "preview": true
    }
  },
  "github": {
    "silent": false,
    "autoAlias": true
  },
  "crons": [
    {
      "path": "/api/cron/update-coffee-prices",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/update-cocoa-price",
      "schedule": "30 17 * * 1-5"
    }
  ]
}
